[Unit]
Description=Omarchy First Boot Handoff
After=network-online.target systemd-user-sessions.service
Wants=network-online.target systemd-user-sessions.service
ConditionPathExists=/var/lib/omarchy/install/install-success.json
ConditionPathExists=!/var/lib/omarchy/firstboot/completed.json

[Service]
Type=oneshot
ExecStart=/usr/local/bin/omarchy-firstboot-wrapper.sh
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
